SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
LOCAL_OUTPUT_DIR=~/Downloads
WORKER_RUNNER=cloud
# Path to a Netscape-format cookies.txt file (preferred for VPS/Docker — no browser needed)
COOKIES_FILE=/app/cookies.txt
# Alternatively, extract cookies live from a local browser (local dev only)
# COOKIES_FROM_BROWSER=chrome
# yt-dlp YouTube player client override (defaults to web_embedded when cookies are set)
# YTDLP_PLAYER_CLIENT=web_embedded
